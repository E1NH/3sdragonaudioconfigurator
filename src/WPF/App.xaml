<Application x:Class="DragonOS.AudioConfigurator.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DragonOS.AudioConfigurator.WPF.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- Converters declared at application scope so they are resolved before any
             window layout pass begins. Declaring them only in Window.Resources caused
             XamlParseException (StaticResource not found) when the DataTemplate was
             first expanded during Show(), because Window.Resources may not yet be fully
             walked at that point in the BAML load sequence. -->
        <views:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
        <views:NullToVisibleConverter   x:Key="NullToVisibleConverter"/>
    </Application.Resources>
</Application>
