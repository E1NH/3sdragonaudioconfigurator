<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net8.0-windows is required for WPF and Windows-specific COM interop. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- The application manifest enforces requireAdministrator UAC elevation.
         This is non-negotiable — the VB-Cable driver installer requires kernel write access. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <AssemblyName>DragonOS.AudioConfigurator</AssemblyName>
    <RootNamespace>DragonOS.AudioConfigurator.WPF</RootNamespace>
    <ApplicationIcon>Resources\dragon.ico</ApplicationIcon>

    <!-- Publish as single-file self-contained exe for GitHub release distribution. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\DragonOS.AudioConfigurator.Core.csproj" />
  </ItemGroup>

</Project>
